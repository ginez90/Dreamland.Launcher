<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DreamlandManifest</AssemblyName>
    <RootNamespace>Dreamland.ManifestGen</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dreamland.Shared\Dreamland.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="manifest-config.example.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
